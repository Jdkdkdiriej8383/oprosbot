# ===================================================================
# Конфигурация Telegram-бота опросов (oprosbot)
# ===================================================================

# Токен вашего бота от @BotFather (ОБЯЗАТЕЛЬНО)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Строка подключения к базе данных SQLite через aiosqlite
DATABASE_URL=sqlite+aiosqlite:///oprosbot.db

# Юзернейм бота без символа @ (опционально, если не указан, определяется автоматически через get_me)
BOT_USERNAME=

# Часовой пояс по умолчанию
TIMEZONE=UTC

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
